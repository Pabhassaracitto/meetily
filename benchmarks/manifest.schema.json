{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meetily.ai/schemas/transcription-benchmark-manifest-1.0.json",
  "title": "Meetily private transcription benchmark manifest",
  "description": "Metadata-only manifest. It must not embed raw audio, transcript text, speaker embeddings, credentials, or voice samples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "data_classification",
    "rights_basis",
    "storage_location",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "data_classification": {
      "enum": ["synthetic", "licensed", "restricted"]
    },
    "rights_basis": {
      "type": "string",
      "minLength": 1,
      "description": "Consent/license/authorization reference, not a raw legal document."
    },
    "storage_location": {
      "type": "string",
      "minLength": 1,
      "description": "Approved private storage reference; do not place a public customer URL here."
    },
    "retention_until": {"type": "string", "format": "date"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reference_id", "tags", "language"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reference_id": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque key matching a private reference/hypothesis JSONL record."
          },
          "language": {"type": "string", "minLength": 2},
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "duration_ms": {"type": "integer", "minimum": 1},
          "reviewer_status": {"enum": ["pending", "approved", "rejected"]},
          "notes_ref": {
            "type": "string",
            "description": "Private notes reference only; do not write transcript text here."
          }
        }
      }
    }
  }
}
